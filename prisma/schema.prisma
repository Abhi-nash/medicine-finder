// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Medicine {
  id             Int     @id @default(autoincrement())
  brandName      String  @map("name")
  manufacturer String?
  compositionKey String  @default("")
  compositions   Composition[]
  shopMedicines ShopMedicine[]

  @@index([compositionKey])
}

model Composition {
  id             Int      @id @default(autoincrement())
  medicineId     Int
  ingredientName String    @map("name")
  strength       String
  medicine       Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([medicineId, ingredientName, strength])
  @@index([medicineId])
}

model Shop {
  id            Int    @id @default(autoincrement())
  shopName      String
  contactNumber String
  pincode       String
  medicines     ShopMedicine[]
  user          User?
}

model ShopMedicine {
  id         Int @id @default(autoincrement())
  shopId     Int
  medicineId Int
  mrp        Float
  quantity   Int
  shop       Shop     @relation(fields: [shopId], references: [id])
  medicine   Medicine @relation(fields: [medicineId], references: [id])
  purchases  Purchase[]
  @@unique([shopId, medicineId])
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  username String @unique
  password String
  role     String @default("CUSTOMER")
  pincode  String?
  shopId Int?  @unique
  shop   Shop? @relation(fields: [shopId], references: [id])
  purchases Purchase[]

  @@index([role])
}

model Purchase {
  id             Int          @id @default(autoincrement())
  buyerId        Int
  shopMedicineId Int
  quantity       Int
  unitPrice      Float
  totalPrice     Float
  status         String       @default("COMPLETED")
  createdAt      DateTime     @default(now())
  buyer          User         @relation(fields: [buyerId], references: [id])
  shopMedicine   ShopMedicine @relation(fields: [shopMedicineId], references: [id])

  @@index([buyerId])
  @@index([shopMedicineId])
}
